# Copy to repo root .env on the AWS server (never commit)

# --- Gateway security (required) ---
# Long random string; your laptop sends: Authorization: Bearer <this>
GATEWAY_SECRET=change_me_to_a_long_random_string

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- Groww (on server only) ---
GROWW_API_KEY=
GROWW_API_SECRET=
# Or use credentials.py on server with API_KEY / API_Secret

# --- Algo ---
ALGO_BROKER=groww
ALGO_SYMBOL=SBIN
ALGO_ALLOWED_SYMBOLS=SBIN
ALGO_MAX_CAPITAL=10000
ALGO_USE_KELLY=1

# Live orders on server (off by default)
# ENABLE_LIVE_TRADING=1
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_RISK
# ALLOW_GROWW_ORDERS=1
