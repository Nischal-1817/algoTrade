[Unit]
Description=Algo Trade Flask Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/algoTrade
EnvironmentFile=/home/ubuntu/algoTrade/.env
ExecStart=/home/ubuntu/algoTrade/.venv/bin/gunicorn -w 1 -b 0.0.0.0:8080 --timeout 120 aws_gateway.app:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
