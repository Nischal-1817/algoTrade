# Copy to .env (gitignored)

# Groww (required for live trading)
GROWW_API_KEY=
GROWW_API_SECRET=

# Algo
ALGO_BROKER=groww
ALGO_SYMBOL=SBIN
ALGO_ALLOWED_SYMBOLS=SBIN
ALGO_MAX_CAPITAL=10000
ALGO_USE_KELLY=1

# Live orders — all required for real Groww orders
# ENABLE_LIVE_TRADING=1
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_RISK
# ALLOW_GROWW_ORDERS=1
